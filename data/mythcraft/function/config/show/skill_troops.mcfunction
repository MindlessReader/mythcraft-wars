# Shows the troop type checkbox dialog for a skill location
# Parameters: all has* booleans + $(skill)
$dialog show @s {type:"minecraft:multi_action",title:"$(skill) - Troop Types",pause:true,body:[{type:"minecraft:plain_message",contents:"Select which troop types can spawn at this skill location.",width:300}],inputs:[{type:"minecraft:boolean",key:"pillager",label:"Marksman (Pillager)",initial:$(hasPillager)},{type:"minecraft:boolean",key:"vindicator",label:"Knight (Vindicator)",initial:$(hasVindicator)},{type:"minecraft:boolean",key:"zombie",label:"Undead (Zombie)",initial:$(hasZombie)},{type:"minecraft:boolean",key:"skeleton",label:"Archer (Skeleton)",initial:$(hasSkeleton)},{type:"minecraft:boolean",key:"witch",label:"Sorceress (Witch)",initial:$(hasWitch)},{type:"minecraft:boolean",key:"bosszombie",label:"Undead Commander",initial:$(hasBosszombie)},{type:"minecraft:boolean",key:"bossskeleton",label:"Greater Archer",initial:$(hasBossskeleton)},{type:"minecraft:boolean",key:"bosswitch",label:"Head Sorceress",initial:$(hasBosswitch)},{type:"minecraft:boolean",key:"blaze",label:"Baron of Blazes",initial:$(hasBlaze)},{type:"minecraft:boolean",key:"breeze",label:"Earl of Air",initial:$(hasBreeze)},{type:"minecraft:boolean",key:"illusioner",label:"Duke of Duplication",initial:$(hasIllusioner)}],columns:2,actions:[{label:{text:"Save",color:"green"},width:150,action:{type:"minecraft:dynamic/run_command",template:"function mythcraft:config/apply/skill_troops {skill:$(skill),pillager:\u0024(pillager),vindicator:\u0024(vindicator),zombie:\u0024(zombie),skeleton:\u0024(skeleton),witch:\u0024(witch),bosszombie:\u0024(bosszombie),bossskeleton:\u0024(bossskeleton),bosswitch:\u0024(bosswitch),blaze:\u0024(blaze),breeze:\u0024(breeze),illusioner:\u0024(illusioner)}"}},{label:{text:"Back"},width:150,action:{type:"minecraft:run_command",command:"function mythcraft:config/edit/skill {skill:$(skill)}"}}]}
