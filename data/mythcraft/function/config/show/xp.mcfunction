# Shows the XP threshold editor dialog with current values pre-filled
# Parameters: $(currentCharLvl2), $(currentCharLvl3), $(currentCharLvl4), $(currentCharLvl5), $(currentSkillLvl1), $(currentSkillLvl2), $(currentSkillLvl3), $(currentSkillLvl4), $(currentSkillLvl5)
$dialog show @s {type:"minecraft:multi_action",title:"XP & Leveling",pause:true,body:[{type:"minecraft:plain_message",contents:"Character XP Thresholds (per-player, levels 2-5)",width:300}],inputs:[{type:"minecraft:text",key:"charLvl2",label:"Character Level 2",initial:"$(currentCharLvl2)",max_length:5},{type:"minecraft:text",key:"charLvl3",label:"Character Level 3",initial:"$(currentCharLvl3)",max_length:5},{type:"minecraft:text",key:"charLvl4",label:"Character Level 4",initial:"$(currentCharLvl4)",max_length:5},{type:"minecraft:text",key:"charLvl5",label:"Character Level 5",initial:"$(currentCharLvl5)",max_length:5},{type:"minecraft:text",key:"skillLvl1",label:"Skill Level 1",initial:"$(currentSkillLvl1)",max_length:5},{type:"minecraft:text",key:"skillLvl2",label:"Skill Level 2",initial:"$(currentSkillLvl2)",max_length:5},{type:"minecraft:text",key:"skillLvl3",label:"Skill Level 3",initial:"$(currentSkillLvl3)",max_length:5},{type:"minecraft:text",key:"skillLvl4",label:"Skill Level 4",initial:"$(currentSkillLvl4)",max_length:5},{type:"minecraft:text",key:"skillLvl5",label:"Skill Level 5",initial:"$(currentSkillLvl5)",max_length:5}],columns:1,actions:[{label:{text:"Save",color:"green"},width:150,action:{type:"minecraft:dynamic/run_command",template:"function mythcraft:config/apply/xp {charLvl2:\u0024(charLvl2),charLvl3:\u0024(charLvl3),charLvl4:\u0024(charLvl4),charLvl5:\u0024(charLvl5),skillLvl1:\u0024(skillLvl1),skillLvl2:\u0024(skillLvl2),skillLvl3:\u0024(skillLvl3),skillLvl4:\u0024(skillLvl4),skillLvl5:\u0024(skillLvl5)}"}},{label:{text:"Back"},width:150,action:{type:"minecraft:run_command",command:"function mythcraft:config/open"}}]}
