# Shows the raid boss type checkbox dialog for a city
# Parameters: $(hasGiantSlime), $(cityId), $(cityNum)
$dialog show @s {type:"minecraft:multi_action",title:"City $(cityNum) - Raid Bosses",pause:true,body:[{type:"minecraft:plain_message",contents:"Select which raid bosses can spawn at this city. If none are selected, this city will never host a raid boss.",width:300}],inputs:[{type:"minecraft:boolean",key:"giant_slime",label:"Ancient Slime King",initial:$(hasGiantSlime)}],columns:2,actions:[{label:{text:"Save",color:"green"},width:150,action:{type:"minecraft:dynamic/run_command",template:"function mythcraft:config/apply/city_raidboss {cityId:$(cityId),cityNum:$(cityNum),giant_slime:\u0024(giant_slime)}"}},{label:{text:"Back"},width:150,action:{type:"minecraft:run_command",command:"function mythcraft:config/edit/city {cityId:$(cityId),cityNum:$(cityNum)}"}}]}
