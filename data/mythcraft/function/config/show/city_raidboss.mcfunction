# Shows the raid boss type checkbox dialog for a city
# Parameters: $(hasGiantSlime), $(hasWarden), $(hasTheTwins), $(cityId), $(cityNum)
$dialog show @s {type:"minecraft:multi_action",title:"City $(cityNum) - Raid Bosses",pause:true,body:[{type:"minecraft:plain_message",contents:"Select which raid bosses can spawn at this city. If none are selected, this city will never host a raid boss.",width:300}],inputs:[{type:"minecraft:boolean",key:"giant_slime",label:"Ancient Slime King",initial:$(hasGiantSlime)},{type:"minecraft:boolean",key:"warden",label:"Literally Just a Warden",initial:$(hasWarden)},{type:"minecraft:boolean",key:"the_twins",label:"The Twins",initial:$(hasTheTwins)}],columns:2,actions:[{label:{text:"Save",color:"green"},width:150,action:{type:"minecraft:dynamic/run_command",template:"function mythcraft:config/apply/city_raidboss {cityId:$(cityId),cityNum:$(cityNum),giant_slime:\u0024(giant_slime),warden:\u0024(warden),the_twins:\u0024(the_twins)}"}},{label:{text:"Back"},width:150,action:{type:"minecraft:run_command",command:"function mythcraft:config/edit/city {cityId:$(cityId),cityNum:$(cityNum)}"}}]}
