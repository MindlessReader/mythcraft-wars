# Shows the raid boss type checkbox dialog for a skill location
# Parameters: $(hasGiantSlime), $(skill)
$dialog show @s {type:"minecraft:multi_action",title:"$(skill) - Raid Bosses",pause:true,body:[{type:"minecraft:plain_message",contents:"Select which raid bosses can spawn at this skill location. If none are selected, this location will never host a raid boss.",width:300}],inputs:[{type:"minecraft:boolean",key:"giant_slime",label:"Ancient Slime King",initial:$(hasGiantSlime)}],columns:2,actions:[{label:{text:"Save",color:"green"},width:150,action:{type:"minecraft:dynamic/run_command",template:"function mythcraft:config/apply/skill_raidboss {skill:$(skill),giant_slime:\u0024(giant_slime)}"}},{label:{text:"Back"},width:150,action:{type:"minecraft:run_command",command:"function mythcraft:config/edit/skill {skill:$(skill)}"}}]}
