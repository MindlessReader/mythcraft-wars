# Shows the troop type checkbox dialog for a city
# Parameters: all has* booleans + $(cityId), $(cityNum)
$dialog show @s {type:"minecraft:multi_action",title:"City $(cityNum) - Troop Types",pause:true,body:[{type:"minecraft:plain_message",contents:"Select which troop types can spawn at this city.",width:300}],inputs:[{type:"minecraft:boolean",key:"pillager",label:"Marksman (Pillager)",initial:$(hasPillager)},{type:"minecraft:boolean",key:"vindicator",label:"Knight (Vindicator)",initial:$(hasVindicator)},{type:"minecraft:boolean",key:"zombie",label:"Undead (Zombie)",initial:$(hasZombie)},{type:"minecraft:boolean",key:"skeleton",label:"Archer (Skeleton)",initial:$(hasSkeleton)},{type:"minecraft:boolean",key:"witch",label:"Sorceress (Witch)",initial:$(hasWitch)},{type:"minecraft:boolean",key:"husk",label:"Desiccated (Husk)",initial:$(hasHusk)},{type:"minecraft:boolean",key:"parched",label:"Sand Archer (Parched)",initial:$(hasParched)},{type:"minecraft:boolean",key:"stray",label:"Frost Archer (Stray)",initial:$(hasStray)},{type:"minecraft:boolean",key:"slime",label:"Ooze (Slime)",initial:$(hasSlime)},{type:"minecraft:boolean",key:"bogged",label:"Poisoner (Bogged)",initial:$(hasBogged)},{type:"minecraft:boolean",key:"piglin",label:"Piglin Raider",initial:$(hasPiglin)},{type:"minecraft:boolean",key:"bosszombie",label:"Undead Commander",initial:$(hasBosszombie)},{type:"minecraft:boolean",key:"bossskeleton",label:"Greater Archer",initial:$(hasBossskeleton)},{type:"minecraft:boolean",key:"bosswitch",label:"Head Sorceress",initial:$(hasBosswitch)},{type:"minecraft:boolean",key:"blaze",label:"Baron of Blazes",initial:$(hasBlaze)},{type:"minecraft:boolean",key:"breeze",label:"Earl of Air",initial:$(hasBreeze)},{type:"minecraft:boolean",key:"illusioner",label:"Duke of Duplication",initial:$(hasIllusioner)},{type:"minecraft:boolean",key:"witherskeleton",label:"Wither Knight",initial:$(hasWitherskeleton)},{type:"minecraft:boolean",key:"evoker",label:"Arch Evoker",initial:$(hasEvoker)},{type:"minecraft:boolean",key:"piglinbrute",label:"Piglin Warlord",initial:$(hasPiglinbrute)},{type:"minecraft:boolean",key:"bossslime",label:"Royal Ooze",initial:$(hasBossslime)}],columns:2,actions:[{label:{text:"Save",color:"green"},width:150,action:{type:"minecraft:dynamic/run_command",template:"function mythcraft:config/apply/city_troops {cityId:$(cityId),cityNum:$(cityNum),pillager:\u0024(pillager),vindicator:\u0024(vindicator),zombie:\u0024(zombie),skeleton:\u0024(skeleton),witch:\u0024(witch),husk:\u0024(husk),parched:\u0024(parched),stray:\u0024(stray),slime:\u0024(slime),bogged:\u0024(bogged),piglin:\u0024(piglin),bosszombie:\u0024(bosszombie),bossskeleton:\u0024(bossskeleton),bosswitch:\u0024(bosswitch),blaze:\u0024(blaze),breeze:\u0024(breeze),illusioner:\u0024(illusioner),witherskeleton:\u0024(witherskeleton),evoker:\u0024(evoker),piglinbrute:\u0024(piglinbrute),bossslime:\u0024(bossslime)}"}},{label:{text:"Back"},width:150,action:{type:"minecraft:run_command",command:"function mythcraft:config/edit/city {cityId:$(cityId),cityNum:$(cityNum)}"}}]}
