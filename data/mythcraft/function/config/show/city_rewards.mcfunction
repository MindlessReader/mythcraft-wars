# Shows the city reward pool checkbox dialog
# Parameters: all has* booleans + $(cityId), $(cityNum)
$dialog show @s {type:"minecraft:multi_action",title:"City $(cityNum) - Rewards",pause:true,body:[{type:"minecraft:plain_message",contents:"Select rewards granted by owning this city. Buff rewards are permanent while your team owns the city.",width:300}],inputs:[{type:"minecraft:boolean",key:"golden_apple",label:"Enchanted Golden Apple",initial:$(hasGoldenApple)},{type:"minecraft:boolean",key:"ender_pearls",label:"5 Ender Pearls",initial:$(hasEnderPearls)},{type:"minecraft:boolean",key:"wind_charges",label:"5 Wind Charges",initial:$(hasWindCharges)},{type:"minecraft:boolean",key:"strength_powder",label:"Blaze Powder of Strength II",initial:$(hasStrengthPowder)},{type:"minecraft:boolean",key:"harming_potions",label:"3 Potions of Harming II",initial:$(hasHarmingPotions)},{type:"minecraft:boolean",key:"trident",label:"Sharpness V Trident",initial:$(hasTrident)},{type:"minecraft:boolean",key:"invis_kelp",label:"5 Invisibility Kelp",initial:$(hasInvisKelp)},{type:"minecraft:boolean",key:"wind_arrows",label:"20 Wind-Charged Arrows",initial:$(hasWindArrows)},{type:"minecraft:boolean",key:"levitation_arrows",label:"5 Levitation Arrows",initial:$(hasLevitationArrows)},{type:"minecraft:boolean",key:"poison_potions",label:"3 Poison Splash Potions",initial:$(hasPoisonPotions)},{type:"minecraft:boolean",key:"regen_tear",label:"Ghast Tear of Regeneration",initial:$(hasRegenTear)},{type:"minecraft:boolean",key:"nourishing_bread",label:"64 Nourishing Bread [Food Slot]",initial:$(hasNourishingBread)},{type:"minecraft:boolean",key:"buff_resistance",label:"Resistance (permanent)",initial:$(hasBuffResistance)},{type:"minecraft:boolean",key:"buff_speed",label:"Speed (permanent)",initial:$(hasBuffSpeed)},{type:"minecraft:boolean",key:"buff_health_boost",label:"Health Boost II (permanent)",initial:$(hasBuffHealthBoost)},{type:"minecraft:boolean",key:"buff_strength",label:"Strength (permanent)",initial:$(hasBuffStrength)}],columns:2,actions:[{label:{text:"Save",color:"green"},width:150,action:{type:"minecraft:dynamic/run_command",template:"function mythcraft:config/apply/city_rewards {cityId:$(cityId),cityNum:$(cityNum),golden_apple:\u0024(golden_apple),ender_pearls:\u0024(ender_pearls),wind_charges:\u0024(wind_charges),strength_powder:\u0024(strength_powder),harming_potions:\u0024(harming_potions),trident:\u0024(trident),invis_kelp:\u0024(invis_kelp),wind_arrows:\u0024(wind_arrows),levitation_arrows:\u0024(levitation_arrows),poison_potions:\u0024(poison_potions),regen_tear:\u0024(regen_tear),nourishing_bread:\u0024(nourishing_bread),buff_resistance:\u0024(buff_resistance),buff_speed:\u0024(buff_speed),buff_health_boost:\u0024(buff_health_boost),buff_strength:\u0024(buff_strength)}"}},{label:{text:"Back"},width:150,action:{type:"minecraft:run_command",command:"function mythcraft:config/edit/city {cityId:$(cityId),cityNum:$(cityNum)}"}}]}
