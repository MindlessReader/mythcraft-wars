# Confirmation dialog showing detected marker info
# Params: $(markerLocation), $(locationDisplayName), $(markerTier)
$dialog show @s {type:"minecraft:multi_action",title:"Marker Helper",pause:true,body:{type:"minecraft:plain_message",contents:["",{text:"Nearest marker detected:\n\n",color:"gold"},{text:"Location ID: ",color:"white"},{text:"$(markerLocation)\n",color:"yellow",bold:true},{text:"Display Name: ",color:"white"},{text:"$(locationDisplayName)\n",color:"aqua"},{text:"Marker Type: ",color:"white"},{text:"$(markerTier)\n\n",color:"light_purple"},{text:"Confirm to start counting all markers at this location.\nThe sidebar will switch to show live marker counts.",color:"gray"}]},columns:2,actions:[{label:{text:"Confirm",color:"green"},width:150,action:{type:"minecraft:run_command",command:"trigger adminAction set 21"}},{label:{text:"Back"},width:150,action:{type:"minecraft:run_command",command:"trigger openMenu set 4"}}]}
