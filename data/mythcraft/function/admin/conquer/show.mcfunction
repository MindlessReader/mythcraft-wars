# City selection dialog for manual conquer
# Params: $(city1) through $(city7)
$dialog show @s {type:"minecraft:multi_action",title:"Manual Conquer - Select City",pause:true,body:{type:"minecraft:plain_message",contents:{text:"Select a city to conquer for a player's team.",color:"gold"}},columns:2,actions:[{label:{text:"$(city1)"},width:150,action:{type:"minecraft:run_command",command:"function mythcraft:admin/conquer/edit_city {cityId:City1,cityNum:1}"}},{label:{text:"$(city2)"},width:150,action:{type:"minecraft:run_command",command:"function mythcraft:admin/conquer/edit_city {cityId:City2,cityNum:2}"}},{label:{text:"$(city3)"},width:150,action:{type:"minecraft:run_command",command:"function mythcraft:admin/conquer/edit_city {cityId:City3,cityNum:3}"}},{label:{text:"$(city4)"},width:150,action:{type:"minecraft:run_command",command:"function mythcraft:admin/conquer/edit_city {cityId:City4,cityNum:4}"}},{label:{text:"$(city5)"},width:150,action:{type:"minecraft:run_command",command:"function mythcraft:admin/conquer/edit_city {cityId:City5,cityNum:5}"}},{label:{text:"$(city6)"},width:150,action:{type:"minecraft:run_command",command:"function mythcraft:admin/conquer/edit_city {cityId:City6,cityNum:6}"}},{label:{text:"$(city7)"},width:150,action:{type:"minecraft:run_command",command:"function mythcraft:admin/conquer/edit_city {cityId:City7,cityNum:7}"}},{label:{text:"Back"},width:150,action:{type:"minecraft:run_command",command:"trigger openMenu set 4"}}]}
