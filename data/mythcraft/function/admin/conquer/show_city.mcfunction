# Username input dialog for manual conquer
# Params: $(cityDisplayName), $(cityId), $(cityNum)
$dialog show @s {type:"minecraft:multi_action",title:"Conquer $(cityDisplayName)",pause:true,body:{type:"minecraft:plain_message",contents:"Enter the username of a player on the team that should conquer this city. The city will be conquered for that player's team."},inputs:[{type:"minecraft:text",key:"playerName",label:"Player Username",initial:"",max_length:16}],columns:1,actions:[{label:{text:"Conquer",color:"green"},width:150,action:{type:"minecraft:dynamic/run_command",template:"function mythcraft:admin/conquer/execute {cityId:$(cityId),playerName:\"\u0024(playerName)\"}"}},{label:{text:"Back"},width:150,action:{type:"minecraft:run_command",command:"trigger adminAction set 2"}}]}
