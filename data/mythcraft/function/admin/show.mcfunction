# Admin menu dialog
# Params: $(debugLabel), $(debugColor), $(godLabel), $(godColor)
$dialog show @s {type:"minecraft:multi_action",title:"Admin Menu",pause:true,body:{type:"minecraft:plain_message",contents:{text:"Admin tools for Mythcraft Wars",color:"gold"}},columns:2,actions:[{label:{text:"Open Config",color:"yellow"},width:150,action:{type:"minecraft:run_command",command:"trigger adminAction set 1"}},{label:{text:"Manual Conquer",color:"gold"},width:150,action:{type:"minecraft:run_command",command:"trigger adminAction set 2"}},{label:{text:"Marker Helper",color:"aqua"},width:150,action:{type:"minecraft:run_command",command:"trigger adminAction set 3"}},{label:{text:"Give Marker Eggs",color:"light_purple"},width:150,action:{type:"minecraft:run_command",command:"trigger adminAction set 8"}},{label:{text:"Delete Near Markers",color:"red"},width:150,action:{type:"minecraft:run_command",command:"trigger adminAction set 9"}},{label:{text:"Start Game",color:"green"},width:150,action:{type:"minecraft:run_command",command:"trigger adminAction set 6"}},{label:{text:"Respawn All Troops",color:"blue"},width:150,action:{type:"minecraft:run_command",command:"trigger adminAction set 7"}},{label:{text:"$(debugLabel)",color:"$(debugColor)"},width:150,action:{type:"minecraft:run_command",command:"trigger adminAction set 4"}},{label:{text:"$(godLabel)",color:"$(godColor)"},width:150,action:{type:"minecraft:run_command",command:"trigger adminAction set 5"}},{label:{text:"Back"},width:150,action:{type:"minecraft:run_command",command:"trigger openMenu set 1"}}]}
