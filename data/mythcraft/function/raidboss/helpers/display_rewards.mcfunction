# Display raid boss rewards in chat (one tellraw per reward)
# Called from post_spawn and announce_victory
execute if data storage mythcraft:config {rewards:{raidBossPool:["victory_point"]}} run tellraw @a [{text:"- 1 Victory Point",color:"light_purple"}]
